<!-- ============================================================ -->
<!-- ArchUnit - For DDD+Hexagonal architecture tests              -->
<!-- ============================================================ -->
<dependency>
    <groupId>com.tngtech.archunit</groupId>
    <artifactId>archunit-junit5</artifactId>
    <version>1.2.1</version>
    <scope>test</scope>
</dependency>

<!-- Usage:
@ParameterizedTest
@ValueSource(strings = {"products", "orders"})
void shouldVerifyHexagonalArchitecture(String moduleName) {
    JavaClasses classes = new ClassFileImporter()
        .importPackages("com.example.%s".formatted(moduleName));

    onionArchitecture()
        .domainModels("com.example.%s.domain..".formatted(moduleName))
        .applicationServices("com.example.%s.application..".formatted(moduleName))
        .adapter("persistence", "com.example.%s.infra.persistence..".formatted(moduleName))
        .adapter("rest", "com.example.%s.interfaces.rest..".formatted(moduleName))
        .check(classes);
}
-->


<!-- ============================================================ -->
<!-- Testcontainers 2.x - For integration tests                   -->
<!-- ============================================================ -->
<!--
  Testcontainers 2.0 (GA Oct 14, 2025) renamed all module artifacts with the
  `testcontainers-` prefix and relocated container classes to
  `org.testcontainers.<module>` packages. Update imports accordingly:
    org.testcontainers.containers.PostgreSQLContainer
      -> org.testcontainers.postgresql.PostgreSQLContainer
-->
<dependency>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-testcontainers</artifactId>
    <scope>test</scope>
</dependency>
<dependency>
    <groupId>org.testcontainers</groupId>
    <artifactId>testcontainers-junit-jupiter</artifactId>
    <scope>test</scope>
</dependency>
<dependency>
    <groupId>org.testcontainers</groupId>
    <artifactId>testcontainers-postgresql</artifactId>
    <scope>test</scope>
</dependency>
<!-- Or for MySQL:
<dependency>
    <groupId>org.testcontainers</groupId>
    <artifactId>testcontainers-mysql</artifactId>
    <scope>test</scope>
</dependency>
-->


