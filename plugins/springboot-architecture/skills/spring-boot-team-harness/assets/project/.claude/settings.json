{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(./mvnw *)",
      "Bash(./mvnw.cmd *)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)"
    ]
  },
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cd \"$CLAUDE_PROJECT_DIR\" && ./mvnw -q -B spotless:apply",
            "timeout": 120
          }
        ]
      }
    ]
  },
  "extraKnownMarketplaces": {
    "springboot-skills-marketplace": {
      "source": {
        "source": "github",
        "repo": "a-pavithraa/springboot-skills-marketplace"
      }
    }
  },
  "enabledPlugins": {
    "springboot-architecture@springboot-skills-marketplace": true
  }
}
